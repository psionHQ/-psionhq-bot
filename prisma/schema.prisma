generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserLanguage {
  en
  ru
}

enum TransactionType {
  TRANSFER
  MINT
  BURN
  REWARD
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id            Int           @id @default(autoincrement())
  telegramId    BigInt        @unique
  username      String?
  firstName     String
  language      UserLanguage  @default(en)
  role          Role          @default(USER)
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  registeredAt  DateTime      @default(now())
  wallet        Wallet?
  adminActions  AdminAction[] @relation("AdminActions")
  targetActions AdminAction[] @relation("TargetActions")

  @@map("users")
}

model Wallet {
  id                   Int           @id @default(autoincrement())
  userId               Int           @unique
  address              String        @unique
  balance              Decimal       @default(0) @db.Decimal(18, 8)
  createdAt            DateTime      @default(now())
  user                 User          @relation(fields: [userId], references: [id])
  outgoingTransactions Transaction[] @relation("WalletOutgoingTransactions")
  incomingTransactions Transaction[] @relation("WalletIncomingTransactions")

  @@map("wallets")
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  fromWalletId Int?
  toWalletId   Int?
  amount       Decimal           @db.Decimal(18, 8)
  type         TransactionType
  status       TransactionStatus
  memo         String?
  createdAt    DateTime          @default(now())
  fromWallet   Wallet?           @relation("WalletOutgoingTransactions", fields: [fromWalletId], references: [id])
  toWallet     Wallet?           @relation("WalletIncomingTransactions", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([createdAt])
  @@map("transactions")
}

model AdminAction {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      Int
  action       String
  targetUserId Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActions", fields: [adminId], references: [id])
  target       User?    @relation("TargetActions", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_actions")
}
