generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserLanguage {
  en
  ru
}

enum TransactionType {
  TRANSFER
  MINT
  BURN
  REWARD
  FEE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id            Int           @id @default(autoincrement())
  telegramId    BigInt        @unique
  username      String?
  firstName     String
  language      UserLanguage  @default(en)
  role          Role          @default(USER)
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  registeredAt  DateTime      @default(now())
  referralCode  String?       @unique @map("referral_code")
  wallet        Wallet?
  adminActions  AdminAction[] @relation("AdminActions")
  targetActions AdminAction[] @relation("TargetActions")
  referrals     Referral[]    @relation("ReferrerReferrals")
  referral      Referral?     @relation("ReferredUserReferral")

  @@map("users")
}

model Referral {
  id         Int      @id @default(autoincrement())
  referrerId Int
  referredId Int      @unique
  createdAt  DateTime @default(now())
  referrer   User     @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referred   User     @relation("ReferredUserReferral", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

model Wallet {
  id                   Int                @id @default(autoincrement())
  userId               Int                @unique
  address              String             @unique
  balance              Decimal            @default(0) @db.Decimal(18, 8)
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id])
  outgoingTransactions Transaction[]      @relation("WalletOutgoingTransactions")
  incomingTransactions Transaction[]      @relation("WalletIncomingTransactions")
  dailyRewardClaim     DailyRewardClaim?

  @@map("wallets")
}

model DailyRewardClaim {
  id        Int      @id @default(autoincrement())
  walletId  Int      @unique
  claimedAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id])

  @@map("daily_reward_claims")
}

model Transaction {
  id           String            @id @default(uuid()) @db.Uuid
  fromWalletId Int?
  toWalletId   Int?
  amount       Decimal           @db.Decimal(18, 8)
  type         TransactionType
  status       TransactionStatus
  memo         String?
  createdAt    DateTime          @default(now())
  fromWallet   Wallet?           @relation("WalletOutgoingTransactions", fields: [fromWalletId], references: [id])
  toWallet     Wallet?           @relation("WalletIncomingTransactions", fields: [toWalletId], references: [id])

  @@index([fromWalletId])
  @@index([toWalletId])
  @@index([createdAt])
  @@map("transactions")
}

model AdminAction {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      Int
  action       String
  targetUserId Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  admin        User     @relation("AdminActions", fields: [adminId], references: [id])
  target       User?    @relation("TargetActions", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_actions")
}
